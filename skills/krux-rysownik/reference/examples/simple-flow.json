{
  "title": "Atencja w skrócie",
  "subtitle": "od tokenów do wyjścia",
  "canvas": { "bg": "#faf8f5" },
  "palette": { "in": "#243b6b", "core": "#1f6b4a", "out": "#6b2a6b", "math": "#5b3a8a" },
  "root": {
    "type": "row", "align": "center",
    "children": [
      { "type": "box", "id": "x", "label": "Tokeny\nx", "color": "in" },
      { "type": "group", "label": "Self-Attention", "color": "core", "dir": "row", "align": "center",
        "children": [
          { "type": "col",
            "children": [
              { "type": "box", "id": "q", "label": "Q", "color": "core" },
              { "type": "box", "id": "k", "label": "K", "color": "core" },
              { "type": "box", "id": "v", "label": "V", "color": "core" }
            ]
          },
          { "type": "box", "id": "sm", "label": "softmax\nQKᵀ/√d", "color": "core" }
        ]
      },
      { "type": "box", "id": "y", "label": "Wyjście\ny", "color": "out" }
    ]
  },
  "sidePanel": {
    "title": "Wzory", "color": "math",
    "items": [
      { "tex": "Q,K,V \\in \\mathbb{R}^{n\\times d}" },
      { "tex": "A = \\mathrm{softmax}\\!\\left(\\tfrac{QK^{\\top}}{\\sqrt{d}}\\right)" },
      { "tex": "y = A\\,V" }
    ]
  },
  "edges": [
    { "from": "x", "to": "q" },
    { "from": "x", "to": "k" },
    { "from": "x", "to": "v" },
    { "from": "q", "to": "sm" },
    { "from": "k", "to": "sm" },
    { "from": "sm", "to": "y" },
    { "from": "v", "to": "y", "dashed": true }
  ]
