  "sidePanel": {
    "title": "Wymiary i wzory",
    "color": "math",
    "items": [
      {
        "tex": "Q_{idx} \\in \\mathbb{R}^{n\\times h\\times d}"
      },
      {
        "tex": "K_{idx} \\in \\mathbb{R}^{n\\times 1\\times d}"
      },
      {
        "tex": "S = \\mathrm{Block/MaxPool}(Q_{idx}K_{idx}^{\\top})"
      },
      {
        "tex": "I = \\mathrm{TopK}(S)"
      },
      {
        "tex": "Q \\in \\mathbb{R}^{n\\times H\\times d}"
      },
      {
        "tex": "O = \\mathrm{SparseAttn}(Q, K[I], V[I])"
      }
    ]
  },
